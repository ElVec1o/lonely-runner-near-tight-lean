theorem theoremC_N5 {k r1 r2 m1 m2 : ℕ} (hk : k + 1 = 5)
    (hr1 : 5 < 2 * r1) (h12 : r1 < r2) (h2N : r2 ≤ 5) (hcop : Nat.Coprime r1 r2)
    (hm1 : r2 ≤ m1) (hm2 : r1 ≤ m2) :
    1 / ((5 : ℕ) : ℝ) ≤ ML (v2Fam k r1 r2 m1 m2) := by
  have hd : (r1 = 3 ∧ r2 = 4) ∨ (r1 = 3 ∧ r2 = 5) ∨ (r1 = 4 ∧ r2 = 5) := by omega
  rcases hd with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact thC_5_3_4 hk hm1 hm2
  · exact thC_5_3_5 hk hm1 hm2
  · exact thC_5_4_5 hk hm1 hm2

