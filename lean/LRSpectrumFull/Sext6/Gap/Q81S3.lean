/-- **Theorem C, `N = 5..9`**: for every coprime pair `N/2 < r1 < r2 <= N` and all multipliers `m1 >= r2`, `m2 >= r1`,
`1/N <= ML (([1,N] \ {r1, r2}) ∪ {m1 r1, m2 r2})`. -/
theorem theoremC_five_nine {k N r1 r2 m1 m2 : ℕ} (hk : k + 1 = N) (hN5 : 5 ≤ N) (hN9 : N ≤ 9)
    (hr1 : N < 2 * r1) (h12 : r1 < r2) (h2N : r2 ≤ N) (hcop : Nat.Coprime r1 r2)
    (hm1 : r2 ≤ m1) (hm2 : r1 ≤ m2) :
    1 / (N : ℝ) ≤ ML (v2Fam k r1 r2 m1 m2) := by
  interval_cases N
  · exact theoremC_N5 hk hr1 h12 h2N hcop hm1 hm2
  · exact theoremC_N6 hk hr1 h12 h2N hcop hm1 hm2
  · exact theoremC_N7 hk hr1 h12 h2N hcop hm1 hm2
  · exact theoremC_N8 hk hr1 h12 h2N hcop hm1 hm2
  · exact theoremC_N9 hk hr1 h12 h2N hcop hm1 hm2

end Gap
