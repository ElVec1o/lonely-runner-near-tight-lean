theorem thC_5_3_4 {k m1 m2 : ℕ} (hk : k + 1 = 5) (hm1 : 4 ≤ m1) (hm2 : 3 ≤ m2) :
    1 / ((5 : ℕ) : ℝ) ≤ ML (v2Fam k 3 4 m1 m2) := by
  have h := cover_all (N := 5) (r1 := 3) (r2 := 4) (P := 27) (Q := 24) ([(1, 1, 40), (1, 1, 25), (1, 7, 65), (1, 1, 14)] : List (ℕ × ℕ × ℕ))
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) m1 m2 hm1 hm2
  exact cov_sound ([(1, 1, 40), (1, 1, 25), (1, 7, 65), (1, 1, 14)] : List (ℕ × ℕ × ℕ)) hk (by norm_num) (by norm_num) (by norm_num) (by decide)
    (by omega) (by omega) h

