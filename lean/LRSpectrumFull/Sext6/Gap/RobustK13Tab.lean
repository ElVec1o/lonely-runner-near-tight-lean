/-!
# Theorem S, hypothesis-free from the exact sieve threshold `N*(k)`, `13 ≤ k ≤ 24`  [2026-11-25]

For `13 ≤ k ≤ 24`: sieve blocks (`FinBlk{k}p{j}`, generated by the accompanying sieve tool, kernel-checked) give
`PrimeWin k N r` for `N*(k) ≤ N ≤ MCheb k - 1`, and `RobustK13Cheb.copWin_cheb_table` gives `CopWin k N r` for `N ≥ MCheb k`.
`N*(k)` = least `N` such that every `N' ≥ N` has at least `T = 3k(k+1)+1` primes in `[N'+1+N'/2, 2N']`
(exact sieve, the accompanying sieve tool).

* `NstarX k`            : `N*(k)` for `13 ≤ k ≤ 24`.
* `copWin_ext`          : `13 ≤ k ≤ 24`, `N*(k) ≤ N` ⟹ `CopWin k N r`.
* `copWin_all`          : `1 ≤ k ≤ 24`, `NstarAll k ≤ N` ⟹ `CopWin k N r` (`NstarAll = Nstar` for `k ≤ 12`).
* `theoremS_all`, `cor_a_all` : Theorem S and Corollary S'(a), no hypothesis, `1 ≤ k ≤ 24`, `N ≥ N*(k)`.
No `sorry`, no `axiom`.

Convention: `N` is a natural number (the size of the ambient interval `[1,N]`); `v : Fin (n+1) → ℤ` is an arbitrary finite family of speeds (repetitions allowed) and `n` is not linked to `N`; `k` counts the entries `> N`. Speeds are the moving runners; the runner at rest is not counted, so a vector of `N` speeds means `N + 1` runners and the Lonely Runner value is `1/(N+1)`.
Hypotheses: those of the individual statements (numerical bounds, structural conditions and, where named in the list above, window predicates such as `PrimeWin`, `CopWin`, `PrimeWindow7`, which later modules discharge for explicit ranges). The unproved predicates `DusartPi`, `LRCHyp`, `CopWinHyp` are not hypotheses of any statement in this module.
Axiom audit: covered by `Axioms18` (`#print axioms`; declarations not printed there are bricks of printed ones, so their axioms are bounded by the printed lines).
-/

namespace LRSpectrumFull
namespace Sext6
namespace Gap

/-- The exact sieve threshold `N*(k)`, `13 ≤ k ≤ 24`. -/
def NstarX : ℕ → ℕ
  | 13 => 10870
  | 14 => 12622
  | 15 => 14784
  | 16 => 16800
  | 17 => 19327
  | 18 => 21342
  | 19 => 24552
  | 20 => 27184
  | 21 => 30046
  | 22 => 33529
  | 23 => 36777
  | 24 => 40456
  | _ => 0

theorem copWin_ext {k N r : ℕ} (hk1 : 13 ≤ k) (hk2 : k ≤ 24) (hN : NstarX k ≤ N)
    (hr1 : 1 ≤ r) (hr : 2 * r ≤ N) : CopWin k N r := by
  interval_cases k
  · have h : 10870 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 72587
    · exact copWin_of_primeWin hr1 (primeWinF13_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr
  · have h : 12622 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 81659
    · exact copWin_of_primeWin hr1 (primeWinF14_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr
  · have h : 14784 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 91379
    · exact copWin_of_primeWin hr1 (primeWinF15_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr
  · have h : 16800 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 101747
    · exact copWin_of_primeWin hr1 (primeWinF16_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr
  · have h : 19327 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 112763
    · exact copWin_of_primeWin hr1 (primeWinF17_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr
  · have h : 21342 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 131615
    · exact copWin_of_primeWin hr1 (primeWinF18_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr
  · have h : 24552 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 144611
    · exact copWin_of_primeWin hr1 (primeWinF19_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr
  · have h : 27184 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 158291
    · exact copWin_of_primeWin hr1 (primeWinF20_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr
  · have h : 30046 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 172655
    · exact copWin_of_primeWin hr1 (primeWinF21_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr
  · have h : 33529 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 187703
    · exact copWin_of_primeWin hr1 (primeWinF22_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr
  · have h : 36777 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 203435
    · exact copWin_of_primeWin hr1 (primeWinF23_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr
  · have h : 40456 ≤ N := by simpa [NstarX] using hN
    by_cases h1 : N ≤ 219851
    · exact copWin_of_primeWin hr1 (primeWinF24_mid h h1 r hr)
    · exact copWin_cheb_table (by norm_num) (by norm_num) (by simp [MCheb]; omega) hr1 hr

/-- `N*(k)`, `1 ≤ k ≤ 24`. -/
def NstarAll (k : ℕ) : ℕ := if k ≤ 12 then Nstar k else NstarX k

theorem copWin_all {k N r : ℕ} (hk1 : 1 ≤ k) (hk2 : k ≤ 24) (hN : NstarAll k ≤ N)
    (hr1 : 1 ≤ r) (hr : 2 * r ≤ N) : CopWin k N r := by
  by_cases h12 : k ≤ 12
  · have h : Nstar k ≤ N := by simpa [NstarAll, h12] using hN
    exact copWin_table hk1 h12 h hr1 hr
  · have h : NstarX k ≤ N := by simpa [NstarAll, h12] using hN
    exact copWin_ext (by omega) hk2 h hr1 hr

/-- **Theorem S, no hypothesis, `1 ≤ k ≤ 24`, every `N ≥ N*(k)`.** -/
theorem theoremS_all {n k N r : ℕ} (hk1 : 1 ≤ k) (hk2 : k ≤ 24) (hN : NstarAll k ≤ N)
    (hr1 : 1 ≤ r) (hr : 2 * r ≤ N) (v : Fin (n + 1) → ℤ)
    (hv : ∀ i, (1 ≤ v i ∧ v i ≤ (N : ℤ) ∧ v i ≠ (r : ℤ)) ∨ (N : ℤ) < v i)
    (hcard : (Finset.univ.filter (fun i : Fin (n + 1) => (N : ℤ) < v i)).card ≤ k) :
    1 / (N : ℝ) ≤ ML v :=
  ML_ge_robust_cop hk1 hr1 (copWin_le (copWin_all hk1 hk2 hN hr1 hr))
    (copWin_all hk1 hk2 hN hr1 hr) v hv hcard

/-- **Corollary S'(a), no hypothesis, `1 ≤ k ≤ 24`, every `N ≥ N*(k)`.** -/
theorem cor_a_all {n k N : ℕ} (hk1 : 1 ≤ k) (hk2 : k ≤ 24) (hN : NstarAll k ≤ N)
    (v : Fin (n + 1) → ℤ) (hpos : ∀ i, 1 ≤ v i)
    (hcard : (Finset.univ.filter (fun i : Fin (n + 1) => (N : ℤ) < v i)).card ≤ k)
    (hML : ML v < 1 / (N : ℝ)) :
    ∀ r : ℕ, 1 ≤ r → 2 * r ≤ N → ∃ i, v i = (r : ℤ) :=
  cor_a_cop hk1 (fun _ hr1 hr2 => copWin_all hk1 hk2 hN hr1 hr2) v hpos hcard hML

